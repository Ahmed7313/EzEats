<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EzEats" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:statusBarColor">@color/main_color</item>
        <item name="colorAccent">@color/main_color</item>
        <item name="colorPrimary">@color/main_color</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Theme.EzEats" parent="Base.Theme.EzEats" />

    <style name="HintTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item> <!-- Set your desired hint size -->
        <item name="android:textColor">@color/light_gray
        </item> <!-- Optional: Set your desired hint color -->
    </style>

    <style name="defaultInputText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColor">@color/black</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="hintTextColor">@color/black</item>
        <item name="hintEnabled">true</item>
        <item name="boxStrokeColor">@color/border_color</item>
        <item name="boxStrokeErrorColor">@color/main_color</item>
        <item name="boxCornerRadiusBottomStart">@dimen/_75sdp</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/_75sdp</item>
        <item name="boxCornerRadiusTopEnd">@dimen/_75sdp</item>
        <item name="boxCornerRadiusTopStart">@dimen/_75sdp</item>
    </style>

    <style name="ProgressBar.ButtonStyle" parent="android:Widget.ProgressBar.Horizontal">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/progress_bar_button</item>
    </style>

    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemBackground">@null</item>
        <item name="android:iconTint">@null</item>
    </style>

    <style name="TextProfile">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:fontFamily">@font/gilroy_600</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">center_vertical</item>

    </style>


    <style name="FullScreenBottomSheet" parent="Theme.Design.BottomSheetDialog">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">bottom</item>
    </style>

    <style name="FullWidthBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FullWidthBottomSheetStyle</item>
    </style>

    <style name="FullWidthBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:radius">@dimen/_20sdp</item>
        <item name="behavior_peekHeight">0dp</item>
    </style>



</resources>