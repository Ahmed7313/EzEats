<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="mainViewModel"
            type="com.easyEats.ezeats.ui.main.main.MainViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7"
        tools:context=".ui.main.main.HomeActivity">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nav_view"
            style="@style/BottomNavigationStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_57sdp"
            android:layout_margin="@dimen/_15sdp"
            android:background="@drawable/nav_background_curved"
            android:visibility="@{mainViewModel.isConnected ? View.VISIBLE : View.GONE}"
            app:itemIconSize="@dimen/_26sdp"
            app:labelVisibilityMode="unlabeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:menu="@menu/bottom_nav_menu"/>


        <fragment
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/nav_view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/main_nav" />
        <include
            android:id="@+id/loader"
            layout="@layout/item_loading"
            android:visibility="gone" />

        <include
            android:id="@+id/clInternetConnectionError"
            layout="@layout/no_internet_connection"
            android:visibility="@{mainViewModel.isConnected ? View.GONE : View.VISIBLE,default=gone}" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
