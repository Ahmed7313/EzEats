<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="offer"
            type="com.easyEats.ezeats.domain.main.model.response.home_response.HotDeal" />

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        app:cardCornerRadius="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/roundedImageView"
                loadImage="@{offer.offerLogo}"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_95sdp"
                android:layout_margin="@dimen/_7sdp"
                android:contentDescription="@string/offer_image"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:riv_corner_radius="@dimen/_3sdp" />

            <View
                android:id="@+id/view3"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/logo_background2"
                app:layout_constraintStart_toEndOf="@+id/roundedImageView"
                app:layout_constraintTop_toTopOf="@+id/roundedImageView" />

            <ImageView
                android:id="@+id/iv_restaurant_logo"
                loadImage="@{offer.restaurantLogo}"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@string/restaurant_logo"
                app:layout_constraintBottom_toBottomOf="@+id/view3"
                app:layout_constraintEnd_toEndOf="@+id/view3"
                app:layout_constraintStart_toStartOf="@+id/view3"
                app:layout_constraintTop_toTopOf="@+id/view3" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:ellipsize="end"
                android:fontFamily="@font/gilroy_600"
                android:maxLines="2"
                android:text="@{offer.name}"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="@+id/view3"
                app:layout_constraintEnd_toStartOf="@+id/textView11"
                app:layout_constraintStart_toEndOf="@+id/view3"
                app:layout_constraintTop_toTopOf="@+id/view3"
                tools:text="Flat 50% discount on
your order from Dominos " />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/special_offer_badge"
                android:fontFamily="@font/gilroy_500"
                android:paddingHorizontal="@dimen/_17sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="@string/new_"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:visibility="@{offer.isNew==true ? View.VISIBLE:View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_25sdp"
                android:ellipsize="end"
                android:fontFamily="@font/gilroy_600"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="@dimen/_7sdp"
                android:maxLines="2"
                android:text="@{offer.description}"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/view3"
                app:layout_constraintTop_toBottomOf="@+id/view3"
                tools:text="Get one free Pizza of the same size when you buy any pizza, this valid is only redeemable via EZeats" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/points_background"
                android:fontFamily="@font/gilroy_600"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="@{offer.points.toString()}"
                android:textColor="@color/white"
                android:textSize="@dimen/_8ssp"
                android:visibility="@{offer.points!=null? View.VISIBLE: View.GONE}"
                app:layout_constraintBottom_toBottomOf="@+id/roundedImageView"
                app:layout_constraintStart_toStartOf="@+id/textView12"
                app:layout_constraintTop_toBottomOf="@+id/textView12"
                tools:text="300 Points" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>
</layout>