<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:id="@+id/imageSlideIcon"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_400sdp"
            android:adjustViewBounds="true"
            android:background="@drawable/onboarding_bakground"
            android:contentDescription="@string/description"
            android:scaleType="centerInside"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/welcome_icon" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_19sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/gilroy_700"
            android:gravity="start"
            android:textColor="@color/onBoarding_title"
            android:textSize="@dimen/_18ssp"
            app:layout_constraintTop_toBottomOf="@id/imageSlideIcon"
            tools:text="Title Text" />

        <TextView
            android:id="@+id/textDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/gilroy_600"
            android:gravity="start"
            android:lineSpacingExtra="4dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/onBoarding_title"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toEndOf="@+id/textTitle"
            app:layout_constraintStart_toStartOf="@+id/textTitle"
            app:layout_constraintTop_toBottomOf="@id/textTitle"
            tools:text="Description Text" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>