<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="restaurant"
            type="com.easyEats.ezeats.domain.main.model.response.restaurant_reponse.Restaurant" />

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_7sdp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_restaurant_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/imageFood"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:elevation="0dp"
                    app:cardCornerRadius="@dimen/_4sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <ImageView
                        loadImage="@{restaurant.logo}"
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/restaurant_logo"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_7sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/gilroy_700"
                    android:maxLines="1"
                    android:lines="1"
                    android:text="@{restaurant.name}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp"
                    app:layout_constraintStart_toEndOf="@+id/imageFood"
                    app:layout_constraintTop_toTopOf="@+id/imageFood"
                    tools:text="Dominate Pizza plah plah plah" />

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:fontFamily="@font/gilroy_400"
                    setCategories="@{restaurant.categories}"
                    android:textColor="@color/main_color"
                    android:textSize="@dimen/_7ssp"
                    tools:text="Fast food, Pizza"
                    app:layout_constraintStart_toStartOf="@+id/tvName"
                    app:layout_constraintTop_toBottomOf="@+id/tvName" />

                <TextView
                    android:id="@+id/tvReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:drawablePadding="@dimen/_3sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:gravity="center"
                    android:text='@{String.format("%s Stars (%s Reviews)", restaurant.rating.toString(), restaurant.reviewsCount.toString())}'
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    app:drawableStartCompat="@drawable/star_review_icon"
                    app:layout_constraintStart_toStartOf="@+id/tvType"
                    app:layout_constraintTop_toBottomOf="@+id/tvType"
                    tools:text="4.5 Stars (112 Reviews)" />

                <TextView
                    android:id="@+id/tvMeterAway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:drawablePadding="@dimen/_3sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:gravity="start"
                    android:text='@{String.format("%s", restaurant.distance.toString())}'
                    android:textColor="@color/main_color"
                    android:textSize="@dimen/_12ssp"
                    app:drawableStartCompat="@drawable/marker_pin_icon"
                    app:drawableTint="@color/main_color"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="@+id/tvReview"
                    app:layout_constraintTop_toBottomOf="@+id/tvReview"
                    tools:text="2 KM’s away" />

                <View
                    android:id="@+id/view2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:background="#DADADA"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvMeterAway">

                </View>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExtraOffers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_restaurant_details"
                tools:listitem="@layout/item_extra_offer" />

            <LinearLayout
                android:id="@+id/ll_empty_offers"
                android:layout_width="0dp"
                android:layout_height="@dimen/_45sdp"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/rvExtraOffers"
                app:layout_constraintTop_toBottomOf="@+id/cl_restaurant_details">

                <TextView
                    android:id="@+id/tv_restaurant_has_no_offers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_13ssp"
                    app:drawableStartCompat="@drawable/no_offers_icon"
                    tools:text="Papa Johns has no offers right now" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_25sdp"
                    android:fontFamily="@font/gilroy_500"
                    android:text="@string/please_check_again_later_for_the_hottest_offers"
                    android:textColor="#898883"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>
</layout>