<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="voucher"
            type="com.easyEats.ezeats.domain.main.model.response.voucher.VoucherResponseItem" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:cardCornerRadius="@dimen/_7sdp"
            app:cardUseCompatPadding="true"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/ivLogo"
                    loadImage="@{voucher.restaurantCover}"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:scaleType="fitXY"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:riv_oval="true" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:maxLines="3"
                    app:styledText="@{voucher}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintEnd_toStartOf="@+id/tvPoints"
                    app:layout_constraintStart_toEndOf="@+id/ivLogo"
                    app:layout_constraintTop_toTopOf="@+id/ivLogo"
                    tools:text="Tradeline" />

                <TextView
                    android:id="@+id/textView13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_700"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    android:visibility="gone"
                    android:text='@{String.format("next order from %s",voucher.restaurantName)}'
                    app:layout_constraintStart_toStartOf="@+id/tvName"
                    app:layout_constraintTop_toBottomOf="@+id/tvName"
                    tools:text="next order from Nude Bakery" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/gilroy_700"
                    android:maxLines="2"
                    android:visibility="gone"
                    android:text='@{String.format("- %s",voucher.promoCodeTitle)}'
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintEnd_toStartOf="@+id/tvPoints"
                    app:layout_constraintStart_toEndOf="@+id/tvName"
                    app:layout_constraintTop_toTopOf="@+id/ivLogo"
                    tools:text="- Get 30% off on your" />

                <TextView
                    android:id="@+id/tvPoints"
                    android:layout_width="@dimen/_85sdp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/redeemed_background"
                    android:fontFamily="@font/gilroy_600"
                    android:maxLines="1"
                    android:gravity="center"
                    setVoucherBackground="@{voucher}"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10ssp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Redeemed" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:text="@{voucher.promoCodeDescription}"
                    android:textColor="#3A3D42"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/ivLogo"
                    app:layout_constraintTop_toBottomOf="@+id/ivLogo"
                    tools:text="Lorem ipsum dolor sit amet consectetur. Amet tellus enim gravida amet tellus ac placerat pharetra orci." />


                <TextView
                    android:id="@+id/tv_expired_date"
                    setDate="@{voucher.promoCodeExpiryDate.iso.toString()}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:textColor="#9C9DA0"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/ivLogo"
                    app:layout_constraintTop_toBottomOf="@+id/tvDescription"
                    tools:text="Expires 25-09-2024*" />

                <TextView
                    android:id="@+id/tv_promo_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_700"
                    android:maxLines="3"
                    android:textColor="@color/main_color"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_expired_date"
                    android:layout_marginEnd="@dimen/_9sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_expired_date"
                    app:styledText="@{voucher}"
                    tools:text="BRGREZ50" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>