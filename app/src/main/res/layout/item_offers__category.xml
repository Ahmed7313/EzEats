<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="clickListener"
            type="com.easyEats.ezeats.ui.main.percent.adapter.OffersCategoryAdapter.OnCategoryClickListener" />
        <variable
            name="category"
            type="com.easyEats.ezeats.domain.main.model.response.search_response.Category" />

    </data>

    <LinearLayout
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_85sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="@dimen/_75sdp"
            android:layout_height="@dimen/_60sdp"
            android:src="@drawable/test_burger_image"
            loadImage="@{category.categoryLogo}"
            android:contentDescription="@string/category_image" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_700"
            android:textSize="@dimen/_12ssp"
            android:padding="@dimen/_2sdp"
            android:text="@{category.categoryName}"
            android:layout_marginTop="@dimen/_2sdp"
            tools:text="Burger" />


    </LinearLayout>
</layout>