<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="subMenu"
            type="com.easyEats.ezeats.domain.main.model.response.restaurant_menu.SubMenu" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_90sdp"
        android:layout_marginBottom="@dimen/_13sdp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/iv_menu_item"
            loadImage="@{subMenu.coverPhoto.url}"
            android:layout_width="@dimen/_69sdp"
            android:layout_height="@dimen/_69sdp"
            android:contentDescription="@string/restaurant_logo"
            android:scaleType="centerCrop"
            android:src="@drawable/dummy_menu_image"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            app:layout_constraintStart_toEndOf="@+id/iv_menu_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_title_menu_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_11sdp"
                android:fontFamily="@font/gilroy_700"
                android:text="@{subMenu.name}"
                android:textSize="@dimen/_14sdp"
                app:layout_constraintStart_toEndOf="@+id/iv_menu_item"
                app:layout_constraintTop_toTopOf="@+id/iv_menu_item"
                tools:text="Box of 8 Bombs" />

            <TextView
                android:id="@+id/tv_description_menu_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_11sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:ellipsize="end"
                android:fontFamily="@font/gilroy_600"
                android:maxLines="2"
                android:text="@{subMenu.description}"
                android:layout_marginTop="@dimen/_3sdp"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_menu_item"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_menu_item"
                tools:text="Your selection of 8 bollllllklllmbs from our Your selection of 8 bollllllklllmbs from our  Your selection of 8 bollllllklllmbs from our   signature collection. Your selection of 8 bombs from our signature collection. " />

            <TextView
                android:id="@+id/tv_price_menu_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:fontFamily="@font/gilroy_700"
                android:text="@{`EGP ` + subMenu.price}"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/iv_menu_item"
                app:layout_constraintTop_toBottomOf="@+id/tv_description_menu_item"
                tools:text="EGP 500" />


        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:background="#1F000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>