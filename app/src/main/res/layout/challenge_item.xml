<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <!--        <variable-->
        <!--            name="challenge"-->
        <!--            type="com.easyeats.app.model.ChallengeResponse" />-->

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_10sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_1sdp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/linearParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOffer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginVertical="@dimen/_11sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_500"
                    android:gravity="start"
                    android:lineSpacingExtra="@dimen/_6sdp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:drawableTint="@color/black"
                    tools:text="Use our application in 5 different places during the month of February" />

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="end|center"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:background="@drawable/circle_background"
                    android:contentDescription="@string/restaurant_logo"
                    android:padding="@dimen/_8sdp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/dummy_logo_icon">

                </ImageView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvFeatured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_17sdp"
                android:fontFamily="@font/gilroy_700"
                android:textColor="@color/black"
                android:textSize="16sp"
                tools:text="Rewards 300 EZeats Points" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_17sdp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@style/ProgressBar.ButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:progress="80" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/gilroy_700"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="4 Out of 5 Visits" />
            </RelativeLayout>


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>