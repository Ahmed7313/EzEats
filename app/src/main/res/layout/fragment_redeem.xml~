<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <variable
            name="offer"
            type="com.easyEats.ezeats.domain.main.model.response.home_response.HotDeal" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_top_bottom_sheet_white">


        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/imageOffer"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="10dp" />

        <TextView
            android:id="@+id/tvTitleOffer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="25dp"
            android:fontFamily="@font/gilroy_700"
            android:textColor="#3A3D42"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageOffer"
            tools:text="Pretzel Dog" />

        <TextView
            android:id="@+id/tvDescriptionOffer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/gilroy_500"
            android:lineSpacingExtra="4dp"
            android:textColor="#3A3D42"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="@+id/tvTitleOffer"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleOffer"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="25dp"
            tools:text="Get one free Pizza of the same size when you buy any pizza, this valid is only redeemable via EZeats" />


        <include
            android:id="@+id/loader"
            layout="@layout/item_loading"
            android:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>