<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
        <variable
            name="response"
            type="com.easyEats.ezeats.domain.main.model.response.loyality_center.LoyaltyCenterResponse" />

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_loyalty_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_21sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:text="@string/loyalty_center"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_spin_wheel_promo_codes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:elevation="0dp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_loyalty_center"
                    app:layout_constraintTop_toBottomOf="@id/tv_loyalty_center">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/spin_the_wheel_promo_code_image"
                            android:src="@drawable/spin_wheel_promo_codes_image"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/textView17"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:fontFamily="@font/gilroy_600"
                            android:text="@string/spin_the_wheel_codes"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_15ssp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView21"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/gilroy_600"
                            android:textColor="#3A3D42"
                            app:setPoints="@{response.activeSpinWheelVouchers}"
                            android:textSize="@dimen/_11ssp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView17"
                            tools:text="You have 10 unused promo codes,\nstart using them now! " />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_spin_wheel_promo_codes"
                            android:layout_width="@dimen/_105sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_11sdp"
                            android:layout_marginBottom="@dimen/_17sdp"
                            android:fontFamily="@font/gilroy_600"
                            android:maxLines="1"
                            android:enabled="@{response.activeSpinWheelVouchers > 0 ? true : false,default=false}"
                            android:paddingHorizontal="@dimen/_27sdp"
                            android:paddingVertical="@dimen/_5sdp"
                            android:text="@string/view_more"
                            android:textSize="@dimen/_10ssp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/textView21"
                            app:layout_constraintTop_toBottomOf="@+id/textView21" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/linearLayout4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="@id/cv_spin_wheel_promo_codes"
                    app:layout_constraintStart_toStartOf="@id/cv_spin_wheel_promo_codes"
                    app:layout_constraintTop_toBottomOf="@id/cv_spin_wheel_promo_codes">


                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_79sdp"
                        android:layout_marginVertical="@dimen/_2sdp"
                        android:layout_marginEnd="@dimen/_15sdp"
                        android:layout_weight="1"
                        android:elevation="0dp"
                        app:cardCornerRadius="@dimen/_10sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_loyalty_center"
                        app:layout_constraintTop_toBottomOf="@id/tv_loyalty_center">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/spin_the_wheel_promo_code_image"
                                android:src="@drawable/vouchers_icon"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/textView18"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:fontFamily="@font/gilroy_600"
                                android:text="@string/vouchers"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_15ssp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/textView22"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:fontFamily="@font/gilroy_600"
                                android:textColor="#3A3D42"
                                android:textSize="@dimen/_11ssp"
                                app:setVoucherText="@{response.unUsedVouchers}"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/textView18"
                                tools:text="You have \n10 Unused Vouchers" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_79sdp"
                        android:layout_marginVertical="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:elevation="0dp"
                        app:cardCornerRadius="@dimen/_10sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_loyalty_center"
                        app:layout_constraintTop_toBottomOf="@id/tv_loyalty_center">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/imageView7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/spin_the_wheel_promo_code_image"
                                android:src="@drawable/points_icon"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/textView19"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:fontFamily="@font/gilroy_600"
                                android:text="@string/points"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_15ssp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/textView23"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_11sdp"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:fontFamily="@font/gilroy_600"
                                android:textColor="#3A3D42"
                                app:setPointsText="@{response.EZPoints}"
                                android:textSize="@dimen/_12ssp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/textView19"
                                tools:text="You have \n10 Unused Vouchers " />

                            <TextView
                                android:id="@+id/tv_points"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/_9sdp"
                                android:layout_marginBottom="@dimen/_6sdp"
                                android:fontFamily="@font/gilroy_500"
                                android:text="@string/view_all"
                                android:textSize="@dimen/_10ssp"
                                android:enabled="@{response.EZPoints > 0 ? true : false,default=false}"
                                app:drawableRightCompat="@drawable/arrow_gray_right"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>


                <TextView
                    android:id="@+id/textView24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:visibility="@{response.rewards.spinWheelVouchers.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    android:text="@string/spin_the_wheel_codes"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintStart_toStartOf="@+id/linearLayout4"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout4" />

                <TextView
                    android:id="@+id/tv_spin_wheel_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_500"
                    android:text="@string/view_all"
                    android:textSize="@dimen/_12ssp"
                    android:visibility="@{response.rewards.spinWheelVouchers.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    app:drawableRightCompat="@drawable/arrow_gray_big_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/textView24"
                    app:layout_constraintEnd_toEndOf="@+id/linearLayout4"
                    app:layout_constraintTop_toTopOf="@+id/textView24" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSpinWheelPromoCodes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="vertical"
                    android:visibility="@{response.rewards.spinWheelVouchers.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="@+id/tv_spin_wheel_points"
                    app:layout_constraintStart_toStartOf="@+id/textView24"
                    app:layout_constraintTop_toBottomOf="@+id/textView24"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_voucher" />

                <TextView
                    android:id="@+id/textView26"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:text="@string/vouchers"
                    android:textSize="@dimen/_18ssp"
                    android:visibility="@{response.rewards.promocodes.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    app:layout_constraintStart_toStartOf="@+id/linearLayout4"
                    app:layout_constraintTop_toBottomOf="@+id/rvSpinWheelPromoCodes" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_Vouchers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:visibility="@{response.rewards.promocodes.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    app:layout_constraintStart_toStartOf="@+id/textView26"
                    app:layout_constraintTop_toBottomOf="@+id/textView26"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_voucher_loyalty_points"
                    />


                <TextView
                    android:id="@+id/textView27"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:text="@string/points"
                    android:visibility="@{response.points.loyaltyPoints.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintStart_toStartOf="@+id/rv_Vouchers"
                    app:layout_constraintTop_toBottomOf="@+id/rv_Vouchers" />

                <TextView
                    android:id="@+id/tv_all_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_500"
                    android:text="@string/view_all"
                    android:textSize="@dimen/_12ssp"
                    android:visibility="@{response.points.loyaltyPoints.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    app:drawableRightCompat="@drawable/arrow_gray_big_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/textView27"
                    app:layout_constraintEnd_toEndOf="@+id/rvSpinWheelPromoCodes"
                    app:layout_constraintTop_toTopOf="@+id/textView27" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPoints"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="@+id/tv_all_points"
                    app:layout_constraintStart_toStartOf="@+id/textView27"
                    app:layout_constraintTop_toBottomOf="@+id/textView27"
                    android:visibility="@{response.points.loyaltyPoints.size() > 0 ? View.VISIBLE : View.GONE,default=gone}"
                    tools:itemCount="3"
                    android:layout_marginTop="@dimen/_6sdp"
                    tools:listitem="@layout/points_item" />

                <LinearLayout
                    android:id="@+id/ll_empty_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="@{response.points.loyaltyPoints.size() > 0 &amp; response.rewards.spinWheelVouchers.size() > 0 &amp; response.rewards.promocodes.size() > 0 ?  View.GONE:View.VISIBLE }"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvSpinWheelPromoCodes"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/leader_board_image"
                        android:src="@drawable/loyalty_center_place_holder" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_25sdp"
                        android:layout_marginTop="@dimen/_10ssp"
                        android:fontFamily="@font/gilroy_600"
                        android:gravity="center"
                        android:text="@string/keep_collecting_points_and_soon_you_will_be_able_to_redeem_them_in_exchange_for_awesome_deals"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>