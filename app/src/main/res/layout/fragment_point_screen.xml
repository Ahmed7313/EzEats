<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>

        <variable
            name="pointsResponse"
            type="com.easyEats.ezeats.domain.main.model.response.points.PointsResponse" />

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">


                <androidx.cardview.widget.CardView
                    android:id="@+id/card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="@dimen/_3sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_15sdp">

                        <TextView
                            android:id="@+id/tvHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gilroy_700"
                            android:gravity="center"
                            android:text="@string/loyalty_points"
                            android:textColor="#3A3D42"
                            android:textSize="@dimen/_18ssp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvPointsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:drawablePadding="@dimen/_3sdp"
                            android:fontFamily="@font/gilroy_700"
                            android:text="@string/points"
                            android:textColor="#3A3D42"
                            android:textSize="@dimen/_18ssp"
                            app:drawableStartCompat="@drawable/frame_logo"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/pointsCircle"
                            app:layout_constraintTop_toTopOf="@id/pointsCircle" />


                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/gilroy_600"
                            android:lineSpacingExtra="5dp"
                            android:text="@string/you_can_use_your_ezpoints_to_redeem_any_offers_regardless_of_the_restaurant"
                            android:textColor="#3A3D42"
                            android:textSize="@dimen/_10ssp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/pointsCircle"
                            app:layout_constraintTop_toBottomOf="@+id/tvPointsTitle" />

                        <RelativeLayout
                            android:id="@+id/pointsCircle"
                            android:layout_width="@dimen/_100sdp"
                            android:layout_height="@dimen/_100sdp"
                            android:layout_marginTop="@dimen/_16sdp"
                            android:background="@drawable/circle_background_points"
                            android:gravity="center"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvHeader">

                            <TextView
                                android:id="@+id/tvPoints"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/gilroy_700"
                                android:textColor="#3A3D42"
                                android:text="@{String.valueOf(pointsResponse.EZPoints)}"
                                android:textSize="@dimen/_30ssp"
                                tools:text="300" />

                            <TextView
                                android:id="@+id/tvPointsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tvPoints"
                                android:layout_centerHorizontal="true"
                                android:fontFamily="@font/gilroy_600"
                                android:text="@string/points"
                                android:textColor="@color/main_color"
                                android:textSize="@dimen/_14ssp" />
                        </RelativeLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/tvRestaurantPoint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:drawablePadding="@dimen/_3sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:visibility="@{pointsResponse.loyaltyPoints.size()!=0?View.VISIBLE:View.GONE}"
                    android:text="@string/restuarnats_points"
                    android:textColor="#3A3D42"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/card" />

                <TextView
                    android:id="@+id/tvRestaurantDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/gilroy_600"
                    android:lineSpacingExtra="3dp"
                    android:visibility="@{pointsResponse.loyaltyPoints.size()!=0?View.VISIBLE:View.GONE}"
                    android:text="@string/you_can_use_your_ezpoints_to_redeem_any_offers_regardless_of_the_restaurant"
                    android:textColor="#3A3D42"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintEnd_toEndOf="@+id/tvRestaurantPoint"
                    app:layout_constraintStart_toStartOf="@+id/tvRestaurantPoint"
                    app:layout_constraintTop_toBottomOf="@+id/tvRestaurantPoint" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:visibility="@{pointsResponse.loyaltyPoints.size()!=0?View.VISIBLE:View.GONE}"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="@+id/tvRestaurantDescription"
                    app:layout_constraintStart_toStartOf="@+id/tvRestaurantDescription"
                    app:layout_constraintTop_toBottomOf="@+id/tvRestaurantDescription"
                    tools:itemCount="3"
                    tools:listitem="@layout/points_item" />

                <LinearLayout
                    android:id="@+id/ll_empty_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/_70sdp"
                    android:visibility="@{pointsResponse.loyaltyPoints.size()!=0?View.GONE:View.VISIBLE}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvPoints"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/leader_board_image"
                        android:src="@drawable/empty_offer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10ssp"
                        android:fontFamily="@font/gilroy_600"
                        android:gravity="center"
                        android:layout_marginHorizontal="@dimen/_25sdp"
                        android:text="@string/keep_collecting_points_and_soon_you_will_be_able_to_redeem_them_in_exchange_for_awesome_deals"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </ScrollView>
</layout>