<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>


    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:orientation="vertical"
        android:padding="@dimen/_5sdp">

        <androidx.cardview.widget.CardView
            android:id="@+id/ivImageOffer"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:backgroundTint="#80F3919B"
            app:cardCornerRadius="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/tvOffer"
            android:layout_width="70dp"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/gilroy_600"
            android:textSize="@dimen/_12ssp"
            android:background="#80F3919B"
            app:layout_constraintEnd_toEndOf="@+id/ivImageOffer"
            app:layout_constraintStart_toStartOf="@+id/ivImageOffer"
            app:layout_constraintTop_toBottomOf="@+id/ivImageOffer"
            tools:text="burger" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>