<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_gray">

        <!-- Top bar: location & search -->
        <RelativeLayout
            android:id="@+id/reTop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/home_top_background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/marker_pin_icon"
                android:drawableEnd="@drawable/arrow_down_icon"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/select_location"
                android:textColor="@color/white"
                android:textSize="12sp"
                />

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:src="@drawable/search_ic"
                android:background="@drawable/rounded_search_background"
                />

            <!-- Categories list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_Categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvLocation"
                android:layout_marginTop="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                tools:listitem="@layout/item_offers__category" />
        </RelativeLayout>

        <!-- 'All Restaurants' header -->
        <TextView
            android:id="@+id/tv_all_restaurants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_restaurant"
            android:textSize="18sp"
            android:fontFamily="@font/gilroy_700"
            app:layout_constraintTop_toBottomOf="@id/reTop"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"/>

        <!-- Compose-based restaurants list -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_restaurant_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_all_restaurants"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
