<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="featuredAdapter"
            type="com.easyEats.ezeats.ui.main.home.adapter.featured.FeaturedOfferAdapter" />

        <variable
            name="hotDealsAdapter"
            type="com.easyEats.ezeats.ui.main.home.adapter.hot_deals.HotDealsAdapter" />

        <variable
            name="mainViewModel"
            type="com.easyEats.ezeats.ui.main.main.MainViewModel" />

        <variable
            name="homeViewModel"
            type="com.easyEats.ezeats.ui.main.home.HomeViewModel" />

    </data>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeToRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="#F7F7F7"
            android:fillViewport="true"
            tools:context=".ui.main.home.HomeScreenFragment">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F7F7F7"
                android:backgroundTint="#F7F7F7">


                <RelativeLayout
                    android:id="@+id/reTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_top_background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_16sdp"
                        android:layout_marginVertical="@dimen/_17sdp"
                        android:contentDescription="@string/notification_icon"
                        android:visibility="invisible"
                        app:srcCompat="@drawable/notification_icon" />

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginHorizontal="@dimen/_17sdp"
                        android:layout_marginVertical="@dimen/_16sdp"
                        android:contentDescription="@string/app_name"
                        app:srcCompat="@drawable/logo_icon_home">

                    </ImageView>


                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ivLogo"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="@dimen/_16sdp"
                        android:layout_marginTop="@dimen/_26sdp"
                        android:background="?android:selectableItemBackground"
                        android:clickable="true"
                        android:drawablePadding="5dp"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFamily="@font/gilroy_600"
                        android:maxLength="25"
                        android:maxLines="1"
                        android:text="@{homeViewModel.addressLiveData}"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp"
                        app:drawableEndCompat="@drawable/arrow_down_icon"
                        app:drawableStartCompat="@drawable/marker_pin_icon" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="@dimen/_180sdp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvLocation"
                        android:layout_marginHorizontal="@dimen/_16sdp"
                        android:layout_marginVertical="@dimen/_10sdp"
                        android:fontFamily="@font/gilroy_700"
                        android:lineSpacingExtra="@dimen/_8sdp"
                        android:text="@string/where_every_meal_comes_with_a_discount"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15ssp" />


                    <LinearLayout
                        android:id="@+id/linearContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/tvTitle"
                        android:layout_marginTop="40dp"
                        android:background="@drawable/home_rounded_layout"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_17sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_50sdp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvFeatured"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_700"
                                android:text="@string/featured"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_15ssp" />

                            <TextView
                                android:id="@+id/tvViewAllFeatured"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="5dp"
                                android:fontFamily="@font/gilroy_500"
                                android:gravity="end"
                                android:text="@string/view_all"
                                android:textColor="@color/main_color"
                                android:textSize="@dimen/_12ssp"
                                android:textStyle="normal"
                                app:drawableEndCompat="@drawable/arrow_right" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTitleListFeatured"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:maxLines="2"
                            android:text="@string/check_out_today_s_featured_deals_and_offers_near_you"
                            android:textColor="#898883"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="normal" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvFeatured"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            app:data="@{homeViewModel.featuredOffers}"
                            app:featuredAdapter="@{featuredAdapter}"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="2"
                            tools:listitem="@layout/featured_item" />

                        <com.todkars.shimmer.ShimmerRecyclerView
                            android:id="@+id/featured_shimmer_recycler_view"
                            showShimmer="@{homeViewModel.showShimmer}"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:shimmer_recycler_layout="@layout/featured_shimmer" />


                        <me.relex.circleindicator.CircleIndicator3
                            android:id="@+id/indicator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_16sdp"
                            app:ci_drawable="@drawable/indicator_active"
                            app:ci_drawable_unselected="@drawable/indicator_inactive"
                            app:ci_gravity="center"
                            app:ci_height="9dp"
                            app:ci_margin="15dp"
                            app:ci_orientation="horizontal"
                            app:ci_width="35dp"
                            app:data="@{homeViewModel.featuredOffers}"
                            app:indicatorRecyclerView="@{rvFeatured}" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center"
                            android:layout_marginBottom="@dimen/_80sdp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHotDeals"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_700"
                                android:gravity="center_vertical"
                                android:text="@string/hot_deals_near_you"
                                android:textColor="#403A3D42"
                                android:textSize="@dimen/_15ssp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                />

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="@color/main_color"
                                android:padding="@dimen/_3sdp"
                                app:cardCornerRadius="@dimen/_100sdp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center_vertical"
                                    android:gravity="center"
                                    android:padding="@dimen/_2sdp">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/tvViewAllHotDeals"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:background="@color/main_color"
                                        android:fontFamily="@font/gilroy_700"
                                        android:gravity="center_vertical"
                                        android:padding="@dimen/_5sdp"
                                        android:text="@string/coming_soon"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_12ssp"
                                        tools:ignore="TooDeepLayout" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTitleListHotDeals"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/gilroy_500"
                            android:text="@string/check_out_today_s_featured_deals_and_offers_near_you"
                            android:textColor="#898883"
                            android:textSize="@dimen/_12ssp"
                            android:visibility="gone" />

                        <com.todkars.shimmer.ShimmerRecyclerView
                            android:id="@+id/hot_deals_shimmer_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:shimmer_recycler_layout="@layout/shimmer_hot_deals" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHotDeals"
                            data="@{homeViewModel.hotDealsOffers}"
                            hotDealsAdapter="@{hotDealsAdapter}"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:layout_marginBottom="@dimen/_90sdp"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="3"
                            tools:listitem="@layout/hot_deals_item" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cv_allow_access"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_15sdp"
                            android:layout_marginBottom="@dimen/_90sdp"
                            android:visibility="@{homeViewModel.isLocationGranted ? View.GONE :View.VISIBLE}"
                            app:cardCornerRadius="@dimen/_10sdp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="@dimen/_7sdp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/gilroy_700"
                                    android:text="@string/location_access"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_18ssp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_7sdp"
                                    android:fontFamily="@font/gilroy_600"
                                    android:text="@string/for_a_better_user_experience_please_enable_location_access"
                                    android:textAlignment="textStart"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_12ssp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnEnableAccess"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginVertical="@dimen/_7sdp"
                                    android:drawableStart="@drawable/marker_pin_icon"
                                    android:fontFamily="@font/gilroy_600"
                                    android:gravity="center"
                                    android:paddingHorizontal="@dimen/_70sdp"
                                    android:paddingVertical="@dimen/_10sdp"
                                    android:text="@string/enable_access"
                                    android:textSize="@dimen/_12ssp"
                                    app:cornerRadius="@dimen/_100sdp" />


                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvChallenges"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_700"
                                android:text="@string/challenges_for_you"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_15ssp" />

                            <TextView
                                android:id="@+id/tvViewAllChallenges"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="5dp"
                                android:fontFamily="@font/gilroy_500"
                                android:text="@string/view_all"
                                android:textAlignment="viewEnd"
                                android:textColor="@color/main_color"
                                android:textSize="@dimen/_12ssp"
                                app:drawableEndCompat="@drawable/arrow_right" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailsChallenges"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/gilroy_500"
                            android:text="@string/participate_in_challenges_and_earn_points_and_rewards"
                            android:textColor="#898883"
                            android:textSize="@dimen/_12ssp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvChallenges"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:orientation="vertical"
                            android:visibility="gone"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="3"
                            tools:listitem="@layout/challenge_item" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvTitle"
                        android:layout_alignStart="@+id/tvTitle"
                        android:layout_alignEnd="@+id/ivNotification"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:backgroundTint="@color/white"
                        app:cardCornerRadius="@dimen/_100sdp"
                        app:cardElevation="@dimen/_5sdp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/etSearch"
                            style="@style/defaultInputText"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginHorizontal="@dimen/_17sdp"
                            android:background="@drawable/rounded_search_background"
                            android:drawablePadding="10dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:hint="@string/search_for_restaurants_dishes_and_more"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_11ssp"
                            app:drawableStartCompat="@drawable/search_icon"
                            app:hintTextColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</layout>