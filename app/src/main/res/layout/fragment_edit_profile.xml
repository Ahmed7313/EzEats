<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.easyEats.ezeats.ui.main.edit_profile.EditProfileViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7"
        tools:context=".ui.main.edit_profile.EditProfileFragment">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/back_arrow_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/tv_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_600"
            android:onClick="@{()->viewModel.makeViewsEditable()}"
            android:padding="@dimen/_5sdp"
            android:text="@string/edit"
            android:textColor="@color/main_color"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/containerHeader"
            app:layout_constraintEnd_toEndOf="@+id/containerHeader" />

        <LinearLayout
            android:id="@+id/containerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_40sdp"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/ivProfile"
                loadProfileImage="@{viewModel.user.profilePicture.url}"
                android:layout_width="@dimen/_70sdp"
                android:layout_height="@dimen/_70sdp"
                android:saveEnabled="@{viewModel.isViewsEditable==true?true:false}"
                android:scaleType="fitXY"
                android:src="@drawable/dummy_image"
                app:riv_corner_radius="1000dp"
                app:riv_oval="true">

            </com.makeramen.roundedimageview.RoundedImageView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcv_editProfile"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="-20dp"
                android:layout_marginTop="@dimen/_3sdp"
                android:backgroundTint="@color/main_color"
                android:elevation="0dp"
                android:saveEnabled="false"
                android:visibility="@{viewModel.isViewsEditable==true?View.VISIBLE:View.GONE}"
                app:cardCornerRadius="1000dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/edit_icon" />
            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:lineSpacingExtra="@dimen/_3sdp"
                    android:text="@{viewModel.user.getFirstName(viewModel.user.name)}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp"
                    tools:text="Ahmed" />

                <TextView
                    android:id="@+id/tvLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/gilroy_500"
                    android:lineSpacingExtra="@dimen/_3sdp"
                    android:text="@{viewModel.user.getRemainingName(viewModel.user.name)}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp"
                    tools:text="Kenawy" />


                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:text="@{viewModel.user.email}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11ssp"
                    tools:text="a7medsa3dkenawy@gmail.com" />


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_29sdp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="@+id/containerHeader"
            app:layout_constraintStart_toStartOf="@+id/containerHeader"
            app:layout_constraintTop_toBottomOf="@+id/containerHeader">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/defaultInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/full_name"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_social_media_icons">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tv_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:drawableStart="@drawable/user_name_icon"
                    android:drawablePadding="10dp"
                    android:enabled="@{viewModel.isViewsEditable==true?true:false}"
                    android:inputType="text"
                    android:text="@={viewModel.fullName}"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/defaultInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:hint="@string/email"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textSize="@dimen/_13ssp"
                android:visibility="@{viewModel.email!=null ?View.VISIBLE:View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_social_media_icons">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tv_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:drawableStart="@drawable/email_icon"
                    android:drawablePadding="10dp"
                    android:enabled="false"
                    android:inputType="textEmailAddress"
                    android:text="@={viewModel.email}"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/defaultInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:hint="@string/phone_number"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_social_media_icons">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tv_phone_number"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:drawableStart="@drawable/phone_icon"
                    android:drawablePadding="10dp"
                    android:enabled="false"
                    android:inputType="phone"
                    android:text="@={viewModel.mobileNumber}"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/birthDateInputLayout"
                style="@style/defaultInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:hint="@string/birth_date"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_social_media_icons">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tv_birth_date"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:drawableStart="@drawable/calendar_icon"
                    android:drawablePadding="10dp"
                    android:enabled="@{viewModel.isViewsEditable==true?true:false}"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@={viewModel.birthDate}"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_15sdp"
            android:backgroundTint="@color/main_color"
            android:fontFamily="@font/gilroy_600"
            android:onClick="@{()->viewModel.editUserInfoRestaurantResult()}"
            android:paddingVertical="@dimen/_12sdp"
            android:text="@string/save_changes"
            android:textColor="@color/white"
            android:textSize="@dimen/_13ssp"
            android:visibility="@{viewModel.isViewsEditable==true? View.VISIBLE:View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout"
            app:layout_constraintStart_toStartOf="@+id/linearLayout" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>