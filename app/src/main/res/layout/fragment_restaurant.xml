<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="restaurantInfo"
            type="com.easyEats.ezeats.domain.main.model.response.restaurant_reponse.RestaurantInfo" />

        <variable
            name="restaurantViewModel"
            type="com.easyEats.ezeats.ui.main.restaurant.RestaurantViewModel" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.main.restaurant.RestaurantFragment">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iv_restaurant_cover_image"
            android:layout_width="0dp"
            android:layout_height="@dimen/_230sdp"
            android:elevation="0dp"
            app:cardCornerRadius="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@android:color/transparent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    loadImage="@{restaurantInfo.restaurantCover}"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_230sdp"
                    android:contentDescription="@string/restaurant_logo"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_230sdp"
            android:background="@drawable/restaurant_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view3"
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_50sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="@drawable/logo_background"
            app:layout_constraintBottom_toTopOf="@+id/tv_offers_count"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/iv_restaurant_logo"
            loadImage="@{restaurantInfo.restaurantLogo}"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:contentDescription="@string/restaurant_logo"
            android:src="@drawable/ez_eats_icon"
            app:layout_constraintBottom_toBottomOf="@+id/view3"
            app:layout_constraintEnd_toEndOf="@+id/view3"
            app:layout_constraintStart_toStartOf="@+id/view3"
            app:layout_constraintTop_toTopOf="@+id/view3" />

        <TextView
            android:id="@+id/tv_offers_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/gilroy_600"
            android:textColor="#C9C9C9"
            android:textSize="@dimen/_18ssp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/textView7"
            app:layout_constraintStart_toStartOf="@+id/view3"
            tools:text="3 offers" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_7sdp"
            android:fontFamily="@font/gilroy_700"
            android:text="@{restaurantInfo.restaurantName}"
            android:textColor="@color/white"
            android:textSize="@dimen/_24ssp"
            app:layout_constraintBottom_toTopOf="@+id/tvReview"
            app:layout_constraintStart_toStartOf="@+id/view3"
            tools:text="Dominos Pizza" />

        <TextView
            android:id="@+id/tvReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:drawablePadding="@dimen/_5sdp"
            android:fontFamily="@font/gilroy_600"
            android:gravity="center"
            android:text='@{String.format("%s Stars (%s Reviews)", restaurantInfo.rating.toString(), restaurantInfo.reviewsCount.toString())}'
            android:textColor="#C9C9C9"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/star_review_icon"
            app:drawableTint="#C9C9C9"
            app:layout_constraintBottom_toTopOf="@+id/tvMeterAway"
            app:layout_constraintStart_toStartOf="@+id/textView7"
            tools:text="4.5 Stars (112 Reviews)" />

        <TextView
            android:id="@+id/tvMeterAway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_15ssp"
            android:drawablePadding="@dimen/_5sdp"
            android:fontFamily="@font/gilroy_600"
            android:gravity="start"
            android:text='@{String.format("%s", restaurantInfo.distance.toString())}'
            android:textColor="#C9C9C9"
            android:textSize="@dimen/_12ssp"
            android:visibility="@{restaurantInfo.distance!=null?View.VISIBLE:View.GONE}"
            app:drawableStartCompat="@drawable/marker_pin_icon"
            app:drawableTint="#C9C9C9"
            app:layout_constraintBottom_toBottomOf="@+id/iv_restaurant_cover_image"
            app:layout_constraintStart_toStartOf="@+id/tvReview"
            tools:text="2 KM’s away" />

        <ImageView
            android:id="@+id/tv_share"
            android:layout_width="@dimen/_46sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_35sdp"
            android:background="@drawable/share_background"
            android:contentDescription="@string/share_icon"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/share_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_special_offers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:fontFamily="@font/gilroy_600"
            android:text="@string/special_offers"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvMeterAway"
            app:layout_constraintTop_toBottomOf="@+id/iv_restaurant_cover_image" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_65sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:fontFamily="@font/gilroy_500"
            android:lineSpacingExtra="4dp"
            android:text="@string/enjoy_offers_straight_from_ezeats_in_partnership_with_dominos_pizza_for_your_satisfaction_redeem_now_and_enjoy_the_food_and_the_points"
            android:textColor="@color/black"
            android:textSize="@dimen/_9ssp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvMeterAway"
            app:layout_constraintTop_toBottomOf="@+id/tv_special_offers" />


        <LinearLayout
            android:id="@+id/ll_no_offers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_restaurant_cover_image">

            <ImageView
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_190sdp"
                android:layout_marginTop="@dimen/_25sdp"
                android:src="@drawable/empty_restaurant_placeholder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:fontFamily="@font/gilroy_700"
                android:text="@string/no_offers_available"
                android:textSize="@dimen/_18ssp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_25sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/gilroy_600"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/there_is_no_offers_going_on_right_now_please_check_again_later_for_all_the_pizza_goodness"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_25sdp"
                android:layout_marginTop="@dimen/_35sdp"
                android:layout_marginBottom="@dimen/_25sdp"
                android:backgroundTint="@color/main_color"
                android:paddingVertical="@dimen/_13sdp"
                android:text="@string/check_other_offers"
                android:textColor="@color/white" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialCardView2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="0dp"
            app:cardElevation="@dimen/_5sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_restaurant_cover_image"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_menu_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/menu_header" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sub_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/materialCardView2"
            tools:itemCount="3"
            tools:listitem="@layout/menu_item" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>