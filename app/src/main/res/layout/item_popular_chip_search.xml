<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="popularSearch"
            type="com.easyEats.ezeats.domain.main.model.response.search_response.PopularSearch" />

        <variable
            name="clickListener"
            type="com.easyEats.ezeats.ui.main.search_history.adapter.PopularSearchAdapter.OnPopularSearchClickListener" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="@{() -> clickListener.onPopularSearchClicked(popularSearch)}">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_3sdp"
            app:cardCornerRadius="@dimen/_100sdp">

            <TextView
                android:id="@+id/tvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_search_background"
                android:drawablePadding="@dimen/_5sdp"
                android:fontFamily="@font/gilroy_600"
                android:padding="@dimen/_10sdp"
                android:text="@{popularSearch.term}"
                android:textColor="#212B3D"
                android:lines="1"
                android:maxLines="1"
                android:maxLength="20"
                android:ellipsize="end"
                android:textSize="@dimen/_11sdp"
                app:drawableStartCompat="@drawable/rocket_icon"
                tools:text="Burger king" />
        </androidx.cardview.widget.CardView>


    </LinearLayout>
</layout>