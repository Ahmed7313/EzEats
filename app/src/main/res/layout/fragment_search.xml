<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="searchViewModel"
            type="com.easyEats.ezeats.ui.main.search_suggestion.SearchViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F7F7F7">

            <RelativeLayout
                android:id="@+id/reTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F7F7F7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <EditText
                    android:id="@+id/etRealSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:background="@drawable/rounded_search_background"
                    android:clickable="true"
                    android:drawableLeft="@drawable/search_icon"
                    android:drawablePadding="@dimen/_7sdp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_10ssp"
                    android:singleLine="true"
                    android:text="@={searchViewModel.searchKey}"
                    android:textColor="@color/black"
                    app:hintTextColor="@color/black"
                    app:iconifiedByDefault="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:queryBackground="@drawable/rounded_search_background"
                    app:searchIcon="@drawable/search_icon" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSuggestionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/etRealSearch"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="vertical"
                    android:visibility="@{searchViewModel._isEmptySearch? View.GONE:View.VISIBLE}"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etRealSearch"
                    tools:itemCount="30"
                    tools:listitem="@layout/item_suggestion" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etRealSearch"
                    android:layout_marginTop="@dimen/_100sdp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="@{searchViewModel._isEmptySearch? View.VISIBLE:View.GONE}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/empty_search_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_30sdp"
                        android:fontFamily="@font/gilroy_700"
                        android:gravity="center"
                        android:text="@string/deliciousness_is_just_a_search_away"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold" />

                </LinearLayout>
            </RelativeLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>
</layout>