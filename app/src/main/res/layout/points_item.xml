<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="restaurantPoint"
            type="com.easyEats.ezeats.domain.main.model.response.points.RestaurantPoint" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="@dimen/_3sdp"
            app:cardCornerRadius="@dimen/_7sdp"
            android:background="@color/white"
            app:cardUseCompatPadding="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/ivLogo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    loadImage="@{restaurantPoint.restaurantLogo}"
                    android:layout_width="@dimen/_30sdp"
                    app:riv_oval="true"
                    android:layout_height="@dimen/_30sdp" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    app:layout_constraintStart_toEndOf="@+id/ivLogo"
                    app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
                    app:layout_constraintTop_toTopOf="@+id/ivLogo"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    tools:text="Burger King"
                    android:text="@{restaurantPoint.restaurantName}"
                    android:textColor="#3A3D42"
                    android:textSize="@dimen/_13ssp"
                    android:maxLines="1"
                    android:fontFamily="@font/gilroy_600"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvPoints"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/_8sdp"
                    tools:text="320pts"
                    android:text="@{String.valueOf(restaurantPoint.points)}"
                    android:textColor="#EA374A"
                    android:textSize="@dimen/_13ssp"
                    android:fontFamily="@font/gilroy_600"
                    app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
                    app:layout_constraintEnd_toStartOf="@+id/pointsCircle"
                    app:layout_constraintStart_toEndOf="@+id/tvName"
                    app:layout_constraintTop_toTopOf="@+id/ivLogo" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:textColor="#3A3D42"
                    android:textSize="@dimen/_10ssp"
                    android:text='@{"You can use your " + restaurantPoint.restaurantName + " points to redeem any offer from this restaurant"}'
                    android:fontFamily="@font/gilroy_500"
                    android:layout_marginBottom="@dimen/_3sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/pointsCircle"
                    app:layout_constraintStart_toStartOf="@+id/ivLogo"
                    app:layout_constraintTop_toBottomOf="@+id/ivLogo"
                    tools:text="Lorem ipsum dolor sit amet consectetur. Velit amet consequat pellentesque ut tincidunt. Pellentesque morbi mauris sed gravida et." />

                <RelativeLayout
                    android:id="@+id/pointsCircle"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_70sdp"
                    android:layout_margin="@dimen/_8sdp"
                    android:background="@drawable/circle_background_points_item"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvPointsCircle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        tools:text="300"
                        android:text="@{String.valueOf(restaurantPoint.points)}"
                        android:textColor="#3A3D42"
                        android:textSize="@dimen/_20ssp"
                        android:fontFamily="@font/gilroy_700" />

                    <TextView
                        android:id="@+id/tvPointsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvPointsCircle"
                        android:layout_centerHorizontal="true"
                        android:text="@string/points"
                        android:textColor="#EA374A"
                        android:textSize="@dimen/_10ssp"
                        android:fontFamily="@font/gilroy_600"
                        />
                </RelativeLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>