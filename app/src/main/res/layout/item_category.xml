<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="clickListener"
            type="com.easyEats.ezeats.ui.main.search_history.adapter.CategoryAdapter.OnCategoryClickListener" />

        <variable
            name="category"
            type="com.easyEats.ezeats.domain.main.model.response.search_response.Category" />

    </data>

    <LinearLayout
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_85sdp"
        android:gravity="center_horizontal"
        android:onClick="@{() -> clickListener.onCategoryClicked(category)}"
        android:orientation="vertical"
        android:layout_margin="@dimen/_7sdp"
        tools:ignore="UseCompoundDrawables">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_8sdp"
            app:cardCornerRadius="@dimen/_5sdp">

            <ImageView
                loadImage="@{category.categoryLogo}"
                android:layout_width="@dimen/_75sdp"
                android:layout_height="@dimen/_60sdp"
                android:padding="@dimen/_7sdp"
                android:contentDescription="@string/category_image"
                android:src="@drawable/test_burger_image" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/gilroy_700"
            android:padding="@dimen/_2sdp"
            android:text="@{category.categoryName}"
            android:textSize="@dimen/_12ssp"
            tools:text="Burger" />


    </LinearLayout>
</layout>