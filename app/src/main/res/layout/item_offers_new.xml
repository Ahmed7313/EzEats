<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View"/>

        <variable
            name="restaurant"
            type="com.easyEats.ezeats.domain.main.model.response.restaurant_reponse.new_restaurants_reponse.RestaurantsResponseItem" />

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        app:cardCornerRadius="@dimen/_4sdp"
        app:cardElevation="5dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_restaurant_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/imageFood"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:elevation="0dp"
                    app:cardCornerRadius="0dp"
                    android:backgroundTint="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="@dimen/_95sdp"
                        android:layout_height="@dimen/_100sdp">

                        <ImageView
                            android:id="@+id/imageView8"
                            loadImage="@{restaurant.logo}"
                            android:layout_width="@dimen/_95sdp"
                            android:layout_height="@dimen/_100sdp"
                            android:contentDescription="@string/restaurant_logo"
                            android:scaleType="fitXY"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:background="#B3000000"
                            android:visibility="@{restaurant.available? View.GONE:View.VISIBLE,default=gone}"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/gilroy_500"
                                android:gravity="center"
                                android:text="@string/closed"
                                android:textSize="@dimen/_12ssp"
                                android:visibility="gone"
                                android:textColor="@color/white"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/gilroy_500"
                                android:gravity="center"
                                android:text="@string/busy"
                                android:textSize="@dimen/_12ssp"
                                android:visibility="@{restaurant.isBusy? View.VISIBLE:View.GONE}"
                                android:textColor="@color/white"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:ellipsize="end"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:fontFamily="@font/gilroy_700"
                    android:maxLines="2"
                    android:text="@{restaurant.name}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_pickUp"
                    app:layout_constraintStart_toEndOf="@+id/imageFood"
                    app:layout_constraintTop_toTopOf="@+id/imageFood"
                    tools:text="Dominate Pizza" />

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/gilroy_400"
                    setCategories="@{restaurant.categories}"
                    android:textColor="#3A3D42"
                    android:textSize="@dimen/_8ssp"
                    tools:text="Fast food, Pizza"
                    app:layout_constraintStart_toStartOf="@+id/tvName"
                    app:layout_constraintTop_toBottomOf="@+id/tvName" />

                <TextView
                    android:id="@+id/tvReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:drawablePadding="@dimen/_3sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:gravity="center"
                    android:visibility="gone"
                    android:text='@{String.format("%s Stars (%s Reviews)", restaurant.rating.toString(), restaurant.reviewsCount.toString())}'
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    app:drawableStartCompat="@drawable/star_review_icon"
                    app:layout_constraintStart_toStartOf="@+id/tvType"
                    app:layout_constraintTop_toBottomOf="@+id/tvType"
                    tools:text="4.5 Stars (112 Reviews)" />

                <TextView
                    android:id="@+id/tvMeterAway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:drawablePadding="@dimen/_3sdp"
                    android:fontFamily="@font/gilroy_500"
                    android:gravity="start"
                    android:text='@{String.format("%s", restaurant.distance.toString())}'
                    android:textColor="#3A3D42"
                    android:textSize="@dimen/_10ssp"
                    app:drawableStartCompat="@drawable/marker_pin_icon"
                    app:drawableTint="#3A3D42"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="@+id/tvReview"
                    app:layout_constraintTop_toBottomOf="@+id/tvReview"
                    tools:text="2 KM’s away" />

                <TextView
                    android:id="@+id/tv_pickUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/_3sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:gravity="start"
                    android:text='@{String.format("%s", restaurant.distance.toString())}'
                    android:textColor="#006491"
                    android:textSize="@dimen/_10ssp"
                    android:background="@drawable/pick_up_bg"
                    android:paddingVertical="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    app:drawableStartCompat="@drawable/ic_pick_up"
                    app:drawableTint="#006491"
                    android:visibility="@{restaurant.isPickUp? View.VISIBLE:View.GONE}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvName"
                    tools:text="PickUp" />

                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/_3sdp"
                    android:fontFamily="@font/gilroy_600"
                    android:gravity="start"
                    android:text='@{String.format("%s", restaurant.distance.toString())}'
                    android:textColor="#006491"
                    android:visibility="gone"
                    android:textSize="@dimen/_10ssp"
                    android:background="@drawable/pick_up_bg"
                    android:paddingVertical="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    app:drawableStartCompat="@drawable/ic_pick_up"
                    app:drawableTint="#006491"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvName"
                    tools:text="30M" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scrollbars="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tvReview"
                    app:layout_constraintTop_toBottomOf="@+id/tvMeterAway">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/_4sdp"
                            android:textSize="@dimen/_10ssp"
                            android:paddingStart="@dimen/_5sdp"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:visibility="@{restaurant.isPickUp? View.VISIBLE:View.GONE}"
                            android:background="@drawable/gift_bg"
                            android:fontFamily="@font/gilroy_500"
                            android:textColor="#48C75A"
                            app:drawableStartCompat="@drawable/ic_gift"
                            android:layout_marginEnd="@dimen/_4sdp"
                            tools:text="20% off"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/_4sdp"
                            android:textSize="@dimen/_10ssp"
                            android:paddingStart="@dimen/_5sdp"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:background="@drawable/free_delivery_bg"
                            android:fontFamily="@font/gilroy_500"
                            android:textColor="#EA374A"
                            android:drawablePadding="@dimen/_4sdp"
                            android:visibility="@{restaurant.hasFreeDelivery? View.VISIBLE:View.GONE}"
                            app:drawableStartCompat="@drawable/ic_free_delivery"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:text="@string/free_delivery"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/_4sdp"
                            android:textSize="@dimen/_10ssp"
                            android:paddingStart="@dimen/_5sdp"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:background="@drawable/offers_bg"
                            android:fontFamily="@font/gilroy_500"
                            android:visibility="@{restaurant.hasOffers? View.VISIBLE:View.GONE}"
                            android:textColor="#F98B64"
                            android:drawablePadding="@dimen/_4sdp"
                            app:drawableStartCompat="@drawable/ic_offes"
                            android:layout_marginEnd="@dimen/_4sdp"
                            tools:text="Offers"/>


                    </LinearLayout>
                </HorizontalScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExtraOffers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_restaurant_details"
                tools:listitem="@layout/item_extra_offer" />



        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>
</layout>